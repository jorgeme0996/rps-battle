<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/rps_background</item>
        <item name="colorPrimaryDark">@color/rps_background</item>
        <item name="colorAccent">#FFC93C</item>
        <item name="android:windowBackground">@color/rps_background</item>
    </style>

    <!-- Theme used once the app is running (BridgeActivity switches to it).
         The window is dark so the area behind the status/navigation bars matches the game. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/rps_background</item>
        <item name="android:statusBarColor">@color/rps_background</item>
        <item name="android:navigationBarColor">@color/rps_background</item>
    </style>

    <!-- Launch theme: Android 12+ shows the system splash (icon on dark background);
         older versions show @drawable/splash. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/rps_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
